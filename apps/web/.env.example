# All web data goes through the API to the shared PostgreSQL database.
NODETRAIL_DATA_MODE=api

# API mode only. Set in apps/web/.env.local or Vercel server environment.
# scripts/run_live.py --service web reads the shared API_KEY from the root .env.
# For a separately hosted web server, set these server-side variables there.
# Never prefix secrets with NEXT_PUBLIC_. The web never connects directly to the DB.
NODETRAIL_API_URL=http://127.0.0.1:8000
NODETRAIL_API_KEY=
NODETRAIL_API_KEY_HEADER=X-API-Key

# P3 multipart contract; the host may require a lower transport cap.
NODETRAIL_UPLOAD_FIELD=file
NODETRAIL_MAX_UPLOAD_BYTES=20000000

# P1 canonical attempts use a zero-based option index.
NODETRAIL_ANSWER_ENCODING=index0

# P1 HintRequest uses levels 1..4. Live hints still require P4's verified backend.
NODETRAIL_HINT_FIRST_LEVEL=1
