# Default: explicit local demo, with simulated research/upload/feedback.
NODETRAIL_DATA_MODE=mock

# API mode only. Set in apps/web/.env.local or Vercel server environment.
# Never prefix secrets with NEXT_PUBLIC_. Confirm all values with P2/P3.
NODETRAIL_API_URL=
NODETRAIL_API_KEY=
NODETRAIL_API_KEY_HEADER=

# Confirm multipart field name and maximum file bytes with P3/P2.
# Missing values keep live uploads disabled. Mock mode has a local 10 MiB cap.
NODETRAIL_UPLOAD_FIELD=
NODETRAIL_MAX_UPLOAD_BYTES=

# Set only after P3 confirms answer encoding: index0 or label.
NODETRAIL_ANSWER_ENCODING=

# Set only after P3 confirms the first numeric hint level (e.g. 0 or 1).
NODETRAIL_HINT_FIRST_LEVEL=
