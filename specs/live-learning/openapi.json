  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "concept_slug": {
            "type": "string",
            "title": "Concept Slug"
          },
          "p_known": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Known"
          },
          "why_not_vi": {
            "type": "string",
            "title": "Why Not Vi"
          }
        },
        "type": "object",
        "required": [
          "concept_slug",
          "p_known",
          "why_not_vi"
        ],
        "title": "Alternative",
        "description": "A candidate the rule considered and did not pick."
      },
      "AskInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "subject": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "pro"
            ],
            "title": "Tier"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "subject",
          "tier"
        ],
        "title": "AskInput"
      },
      "AskResponse": {
        "properties": {
          "answer_vi": {
            "type": "string",
            "title": "Answer Vi"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "answer_vi",
          "citations"
        ],
        "title": "AskResponse"
      },
      "AttemptInput": {
        "properties": {
          "client_attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Attempt Id"
          },
          "learner_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Learner Id"
          },
          "item_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Item Id"
          },
          "answer": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Answer"
          },
          "hints_used": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Hints Used",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "learner_id",
          "item_id",
          "answer"
        ],
        "title": "AttemptInput"
      },
      "AttemptResult": {
        "properties": {
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "misconception_vi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Misconception Vi"
          },
          "p_known": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Known"
          },
          "mastered": {
            "type": "boolean",
            "title": "Mastered"
          },
          "remediation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Remediation"
              },
              {
                "type": "null"
              }
            ]
          },
          "traces": {
            "items": {
              "$ref": "#/components/schemas/DecisionTrace"
            },
            "type": "array",
            "title": "Traces"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "correct",
          "p_known",
          "mastered",
          "traces"
        ],
        "title": "AttemptResult"
      },
      "CachedTopic": {
        "properties": {
          "subject_slug": {
            "type": "string",
            "title": "Subject Slug"
          },
          "name_vi": {
            "type": "string",
            "title": "Name Vi"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject_slug",
          "name_vi"
        ],
        "title": "CachedTopic"
      },
      "CachedTopics": {
        "properties": {
          "topics": {
            "items": {
              "$ref": "#/components/schemas/CachedTopic"
            },
            "type": "array",
            "title": "Topics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topics"
        ],
        "title": "CachedTopics"
      },
      "Citation": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "Citation"
      },
      "Concept": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "name_vi": {
            "type": "string",
            "minLength": 1,
            "title": "Name Vi"
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "title": "Name En"
          },
          "description_vi": {
            "type": "string",
            "title": "Description Vi",
            "default": ""
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug",
          "name_vi",
          "name_en",
          "sources"
        ],
        "title": "Concept"
      },
      "ConfirmationInput": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Subject"
          },
          "graph_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Graph Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "graph_revision"
        ],
        "title": "ConfirmationInput"
      },
      "DecisionTrace": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "bkt_update",
              "placement_step",
              "root_cause",
              "next_item",
              "review"
            ],
            "title": "Kind"
          },
          "concept_slug": {
            "type": "string",
            "title": "Concept Slug"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "prior": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence",
            "default": {}
          },
          "posterior": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Posterior"
          },
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "rule_vi": {
            "type": "string",
            "title": "Rule Vi"
